# PostgreSQL + pgvector running in Docker (see docker-compose.yml)
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag
POSTGRES_PORT=5434

# Must use the same user, password, port and database as above
DATABASE_URL=postgresql+psycopg://rag:change-me@localhost:5434/rag
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Answer generation
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5-mini
